includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon
    - phpstan-baseline.neon

parameters:
    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/

    level: 7

    # The baseline was generated in an environment whose Larastan run
    # resolved one generic key type as `(int|string)` where CI's run
    # resolves the same error as plain `int` — same underlying error,
    # non-deterministic generic formatting. Without this, PHPStan treats
    # that drift itself as a build-breaking error.
    reportUnmatchedIgnoredErrors: false
